{
  "realm": "portfolio",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "operator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8181/*"
      ],
      "webOrigins": [
        "http://localhost:8181"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "profile",
        "roles",
        "web-origins",
        "api-audience"
      ]
    },
    {
      "clientId": "qa-alice",
      "secret": "__QA_ALICE_SECRET__",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "roles",
        "api-audience"
      ]
    },
    {
      "clientId": "qa-bob",
      "secret": "__QA_BOB_SECRET__",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "roles",
        "api-audience"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "api-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ledger-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "firstName": "Demo",
      "lastName": "Operator",
      "email": "demo@example.test",
      "emailVerified": true,
      "realmRoles": [
        "operator"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "__DEMO_PASSWORD__",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-qa-alice",
      "enabled": true,
      "serviceAccountClientId": "qa-alice",
      "realmRoles": [
        "operator"
      ]
    },
    {
      "username": "service-account-qa-bob",
      "enabled": true,
      "serviceAccountClientId": "qa-bob",
      "realmRoles": [
        "operator"
      ]
    }
  ]
}
